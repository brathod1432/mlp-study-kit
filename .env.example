# .env.example -- environment variable template for mlp-study-kit
# Copy to .env and fill in values (never commit .env to git)
#
# Currently this project has no required secrets.
# This file documents the optional variables that affect behaviour.

# ── Python path (not required if you ran: pip install -e .) ────────────────
# PYTHONPATH=src

# ── Matplotlib backend (useful on headless servers / CI) ───────────────────
# Set to 'Agg' to disable interactive windows and save plots to files instead.
# MPLBACKEND=Agg

# ── TensorFlow logging verbosity (0=all, 1=no INFO, 2=no WARNING, 3=none) ──
# TF_CPP_MIN_LOG_LEVEL=2

# ── GPU selection (for gpu_test.py) ────────────────────────────────────────
# CUDA_VISIBLE_DEVICES=0
