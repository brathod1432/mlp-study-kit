# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Logs (auto-generated at runtime -- never commit)
logs/
*.log

# PyCharm
.idea/

# Jupyter — ignore checkpoints but track .ipynb source files
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Docx / PDF generated outputs (kept in source only if explicitly added)
*.docx
*.pdf

# Saved model weights / serialised data (can be large + reproducible from training)
*.h5
*.keras
*.pt
*.pth
*.pkl
*.pickle
*.npy
*.npz

# TensorBoard / experiment tracking
*.tfevents.*
runs/
wandb/
mlruns/

# Test / coverage outputs
.coverage
htmlcov/
.pytest_cache/

# Editor swap files
*.swp
*.swo

# AGENTS.md is a local-only AI knowledge base — not pushed to remote
AGENTS.md
# Note: .devin/skills/ IS committed (see .devin/ directory)
# Note: .windsurf/rules/ IS committed

# Environment secrets -- NEVER commit .env
.env

# Compiled C extensions (built by some pip packages in-place)
*.so

# Notebook output artefacts generated by 01_nn_core_intro.ipynb
notebooks/loss_history.png
notebooks/predictions.png
notebooks/activations.png
notebooks/data_preview.png
notebooks/trained_weights.npy
notebooks/.ipynb_checkpoints/

# Generated outputs (plots, weights, CSVs) — keep the directory, ignore contents
outputs/*
!outputs/.gitkeep
